---
interface Props {
  page: number;
  total: number;
  limit: number;
  baseUrl?: string;
  filter?: string;
}

const { page: currentPage, total, limit, baseUrl = "", filter } = Astro.props;

const totalPages = Math.ceil(total / limit);

const createLink = (p: number) => {
  const params = new URLSearchParams();
  if (p > 1) params.set("page", String(p));
  if (filter && filter !== "all") params.set("filter", filter);
  const qs = params.toString();
  return qs ? `${baseUrl}?${qs}` : baseUrl;
};
---

{/* Only render if there is more than one page */}
{totalPages > 1 && (
  <nav aria-label="Pagination" class="flex justify-center mt-12 mb-4">
    <ul class="flex gap-2 list-none p-4 md:p-0 items-center">

      {/* Prev — disabled (non-link) when already on the first page */}
      {currentPage > 1 ? (
        <li>
          <a href={createLink(currentPage - 1)} class="px-3 py-1 rounded text-slate-300 hover:text-white hover:bg-slate-700 transition">Prev</a>
        </li>
      ) : (
        <li class="px-3 py-1 rounded text-slate-600 cursor-not-allowed" aria-disabled="true">Prev</li>
      )}

      {/* Numbered page links — current page is bold + highlighted */}
      {Array.from({ length: totalPages }, (_, i) => {
        const page = i + 1;
        return (
          <li>
            <a
              href={createLink(page)}
            
              aria-current={page === currentPage ? "page" : undefined}
              class={`px-3 py-1 rounded transition ${page === currentPage ? "font-bold text-white bg-slate-600" : "text-slate-300 hover:text-white hover:bg-slate-700"}`}
            >
              {page}
            </a>
          </li>
        );
      })}

      {/* Next — disabled when already on the last page */}
      {currentPage < totalPages ? (
        <li>
          <a href={createLink(currentPage + 1)} class="px-3 py-1 rounded text-slate-300 hover:text-white hover:bg-slate-700 transition">Next</a>
        </li>
      ) : (
        <li class="px-3 py-1 rounded text-slate-600 cursor-not-allowed" aria-disabled="true">Next</li>
      )}

    </ul>
  </nav>
)}
