---
const { filled, index } = Astro.props;
const id = `star-clip-${index}`;
const percent = Math.round(filled * 100);
---
<svg width="22" height="22" viewBox="0 0 22 22" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <clipPath id={id}>
      <rect x="0" y="0" width={`${percent}%`} height="100%" />
    </clipPath>
  </defs>

  <!-- Empty star -->
  <path
    d="M11 1L14.09 7.26L21 8.27L16 13.14L17.18 20.02L11 16.77L4.82 20.02L6 13.14L1 8.27L7.91 7.26L11 1Z"
    fill="#ddd"
    stroke="black"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />

  <!-- Filled star, clipped -->
  <path
    d="M11 1L14.09 7.26L21 8.27L16 13.14L17.18 20.02L11 16.77L4.82 20.02L6 13.14L1 8.27L7.91 7.26L11 1Z"
    fill="#fff"
    stroke="black"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    clip-path={`url(#${id})`}
  />
</svg>