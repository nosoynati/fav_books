---
import { fetchUserBooks } from "../lib/hardcover";
import type { BookFilter } from "../lib/hardcover";
import Pagination from "./Pagination.astro";

interface Props {
  filter: BookFilter;
  page: number;
  limit: number;
}

const { filter, page, limit } = Astro.props;
const offset = (page - 1) * limit;
const { books, total } = await fetchUserBooks(limit, offset, filter);
---

<section aria-label="Book list">
  <div class="px-4 mt-6 mx-auto max-w-screen-xl">
    <div id="book-list" class="columns-2 lg:columns-3 gap-4 sm:gap-2">
      {books.map((user_book: { book: any }) => {
        const { book } = user_book;
        const { id, slug, title, authors, image, description } = book;
        return (
          <article class="break-inside-avoid mb-4 rounded-sm p-2 max-w-64">
            <a href={`/book/${slug}`} class="mb-2 xl:mb-0 transition hover:scale-110">
              <img
                src={image?.url ?? `https://assets.hardcover.app/static/covers/cover${(id % 8) + 1}.webp`}
                alt={title}
                class="w-full max-w-60 m-auto rounded-sm"
              />
            </a>
            <div class="flex flex-col align-top py-2 px-1">
              <h2 class="text-lg font-bold leading-tight text-white">{title}</h2>
              <p class="mb-2 text-sm text-slate-400 text-wrap line-clamp-3">
                {authors?.map((a: any) => a.name).join(", ")}
              </p>
              <p class="text-amber-100 text-wrap line-clamp-3 italic">{description}</p>
              <a href={`/book/${slug}`} aria-label="ver más">ver más...</a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
<div id="pagination-wrapper">
  <Pagination page={page} limit={limit} total={total} baseUrl="/books" filter={filter} />
</div>
