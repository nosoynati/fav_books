---
<div id="page-loader" aria-hidden="true" class="fixed top-0 left-0 z-50 w-full h-0.5 overflow-hidden hidden">
  <div class="h-full bg-amber-200 w-1/3" style="animation: loader-slide 1.2s ease-in-out infinite;"></div>
</div>

<style>
  @keyframes loader-slide {
    0%   { transform: translateX(-150%); }
    100% { transform: translateX(450%); }
  }
</style>

<script>
  const el = () => document.getElementById('page-loader');

  function show() { el()?.classList.remove('hidden'); }
  function hide() { el()?.classList.add('hidden'); }

  document.addEventListener('astro:before-preparation', show);
  document.addEventListener('astro:after-swap', hide);

  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a[data-astro-reload]')) show();
  }, { capture: true });
</script>
