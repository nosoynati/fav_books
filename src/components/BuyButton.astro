---
import AmazonButton from "./AmazonButton.astro";
const SPAIN = "ES";
const ARG = 'AR';
const countryCurrent = Astro.request.headers.get("X-Vercel-IP-Country")
const country = Astro.request.headers.get("X-Vercel-IP-Country") ?? "ES";
console.log(countryCurrent);

const storeCountry = country === SPAIN ? "spain" : "usa";
const countryName = country === SPAIN ? "España" : "Estados Unidos";

const { buy } = Astro.props;
const url = buy[storeCountry];
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="text-balance inline-flex justify-items-center gap-2 py-2 px-4 rounded
             text-black bg-yellow-400 border-yellow-500 hover:bg-yellow-500">
  Comprar en amazon {countryName}
  <AmazonButton />
</a>
