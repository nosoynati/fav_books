---
import Layout from "../../layouts/Layout.astro";
import type { BookFilter } from "../../lib/hardcover";
import BookList from "../../components/BookList.astro";

const LIMIT = 12;
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? 1));
const filter = (Astro.url.searchParams.get("filter") ?? "currently-reading") as BookFilter;

const filters: { key: BookFilter; label: string }[] = [
  { key: "currently-reading", label: "Currently Reading" },
  { key: "read",              label: "Read"              },
  { key: "want-to-read",      label: "Want to Read"      },
  { key: "all",               label: "All Books"         },
];
---

<Layout title="Books">
  <main>
    <div aria-label="Heading wrapper" class="py-2 m-auto">
      <h1 class="text-center text-4xl sm:text-3xl font-extrabold mb-4">My book picks</h1>
    </div>

    <nav class="flex gap-2 justify-center mb-6">
      {filters.map(({ key, label }) => (
        <a
          href={`/books?filter=${key}`}
          data-filter={key}
          data-astro-reload
          class={`px-4 py-1.5 rounded-full text-sm font-medium transition ${
            filter === key
              ? "bg-white text-slate-900"
              : "text-slate-400 border border-slate-600 hover:text-white hover:border-slate-400"
          }`}
        >
          {label}
        </a>
      ))}
    </nav>

    <BookList server:defer filter={filter} page={page} limit={LIMIT}>
      <div slot="fallback" class="px-4 mt-6 mx-auto max-w-screen-xl">
        <div class="columns-2 lg:columns-3 gap-4 sm:gap-2">
          {Array.from({ length: 6 }).map(() => (
            <div class="break-inside-avoid mb-4 rounded-sm p-2 max-w-64 animate-pulse">
              <div class="w-full max-w-60 m-auto rounded-sm bg-slate-800 aspect-[2/3]" />
              <div class="py-2 px-1 space-y-2">
                <div class="h-4 bg-slate-700 rounded w-3/4" />
                <div class="h-3 bg-slate-800 rounded w-1/2" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </BookList>
  </main>
</Layout>
