---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <main class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-5xl sm:text-4xl font-extrabold mb-4">Welcome! :^)</h1>
    <p class="text-slate-400 text-lg max-w-md mb-8">
      This is a personal collection of books I read and want to read.
    </p>
    <a
      href="/books"
      class="px-6 py-2.5 rounded-full bg-white text-slate-900 font-semibold text-sm hover:bg-slate-200 transition"
    >
      Browse Books
    </a>
  </main>
</Layout>
