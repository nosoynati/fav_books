---
import Layout from "../layouts/Layout.astro";
import { fetchUserBooks } from "../lib/hardcover";

export const prerender = true;

const user_books = await fetchUserBooks();
 
---

<Layout title="Libros">
  <main>
    <h1 class="text-center text-4xl lg:text-7xl font-extrabold mb-4">Mis libros favoritos</h1>

    <section aria-label="Libros recomendados favoritos">
      <div class="px-4 mt-6 mx-auto max-w-screen-xl">
        <div class="grid gap-6 md:grid-cols-2">
          {
            user_books?.map((user_book: { book_id: any; book: any; }) => {
              const { book_id, book } = user_book
              const { id, slug, title, author, image, description } = book ;

              return (
                <article class="grid grid-cols-2 gap-4">
                  <a href={`/book/${slug}`} class="mb-2 xl:mb-0 transition hover:scale-110">
                    <img src={`${image?.url || "https://placehold.co/200x200.png"} `}alt={title} class="w-full max-w-72 rounded-md" />
                  </a>
                  <div class="flex flex-col align-top">
                    <h2 class="mb-2 text-2xl font-bold leading-tight text-white">
                      {title}: {author}
                    </h2>
                    <p class="text-amber-100 text-wrap line-clamp-3 italic">{description}</p>
                    <a href={`/book/${slug}`} aria-details="ver más">
                      ver más...
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
