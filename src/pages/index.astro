---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const books = await getCollection("books");
---

<Layout title="Libros">
  <main>
    <h1 class="text-center text-4xl lg:text-7xl font-extrabold mb-4">Mis libros favoritos</h1>

    <section aria-label="Libros recomendados favoritos">
      <div class="px-4 mt-6 mx-auto max-w-screen-xl">
        <div class="grid gap-6 md:grid-cols-2 2xl:grid-cols-3">
          {
            books.map((book) => {
              const { slug, data } = book;
              const { title, author, img, buy, description } = data;

              return (
                <article class="grid grid-cols-2 gap-4">
                  <a href={`/libro/${slug}`} class="mb-2 xl:mb-0 transition hover:scale-110">
                    <img src={`/img/${img}`} alt={title} class="mr-5 w-full max-w-60 rounded-md" />
                  </a>
                  <div class="flex flex-col align-top">
                    <h2 class="mb-2 text-2xl font-bold leading-tight text-white">
                    {title}: {author}
                  </h2>
                  <p class="text-amber-100 text-wrap line-clamp-3 italic">{description}</p>
                  <a href={`/libro/${slug}`} aria-details="ver más" >ver más...</a>
                  </div>
                  
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
